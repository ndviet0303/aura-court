{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "booing",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-02",
  "vars": {
    "PUBLIC_API_URL": "https://court-api.ziet.dev"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
