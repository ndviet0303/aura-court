# Production defaults. Inject secrets through Portainer variables.
APP_NAME="Aura Court"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.example.com
FRONTEND_URL=https://court.ziet.dev
APP_TIMEZONE=Asia/Ho_Chi_Minh

CORS_ALLOWED_ORIGINS=https://court.ziet.dev
SANCTUM_STATEFUL_DOMAINS=court.ziet.dev

SESSION_DRIVER=database
SESSION_DOMAIN=.ziet.dev
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_ENCRYPT=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=booking
DB_HOST=
DB_USERNAME=
DB_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Aura Court"

SEPAY_ENABLED=true
SEPAY_BANK=VCB
SEPAY_ACCOUNT=
SEPAY_API_KEY=
SEPAY_HMAC_SECRET=
SEPAY_BASE_URL=https://my.sepay.vn

PAYMENT_PROVIDER=payos
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_WEBHOOK_SECRET=
PLATFORM_COMMISSION_BPS=500
PAYMENT_PROVIDER_FEE_BPS=0
MINIMUM_PAYOUT_AMOUNT=500000
SETTLEMENT_DELAY_DAYS=2
FEATURE_MARKETPLACE_PAYOUTS=false
PILOT_ORGANIZATION_IDS=
OBSERVABILITY_LOG_CHANNEL=structured
QUEUE_LAG_ALERT_SECONDS=30

# Replace the empty values above with production credentials before deploy.
