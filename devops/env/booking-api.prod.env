# Production defaults. Inject secrets through Portainer variables.
APP_NAME="Aura Court"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.example.com
FRONTEND_URL=https://frontend.example.com
APP_TIMEZONE=Asia/Ho_Chi_Minh

CORS_ALLOWED_ORIGINS=https://frontend.example.com
SANCTUM_STATEFUL_DOMAINS=frontend.example.com

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database

DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=booking
DB_HOST=
DB_USERNAME=
DB_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Aura Court"

SEPAY_ENABLED=true
SEPAY_BANK=VCB
SEPAY_ACCOUNT=
SEPAY_API_KEY=
SEPAY_HMAC_SECRET=
SEPAY_BASE_URL=https://my.sepay.vn

# Replace the empty values above with production credentials before deploy.
