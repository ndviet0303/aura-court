# Production defaults. Inject secrets through Portainer variables.
APP_NAME="Aura Court"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://frontend.example.com
APP_TIMEZONE=Asia/Ho_Chi_Minh

CORS_ALLOWED_ORIGINS=https://frontend.example.com
SANCTUM_STATEFUL_DOMAINS=frontend.example.com

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database

DB_CONNECTION=pgsql
DB_PORT=5432

MAIL_MAILER=smtp
MAIL_PORT=587
MAIL_FROM_NAME="Aura Court"

SEPAY_ENABLED=true
SEPAY_BANK=VCB
SEPAY_BASE_URL=https://my.sepay.vn

# Set these through Portainer for the real domains and credentials:
# APP_KEY, DB_DATABASE, DB_HOST, DB_USERNAME, DB_PASSWORD,
# REDIS_HOST, REDIS_PASSWORD, MAIL_HOST, MAIL_USERNAME, MAIL_PASSWORD,
# MAIL_FROM_ADDRESS, SEPAY_ACCOUNT, SEPAY_API_KEY, SEPAY_HMAC_SECRET.
